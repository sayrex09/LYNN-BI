{
  "name": "ANAHUI Industrial",
  "dataColors": [
    "#0E7C66",
    "#14A085",
    "#57C4A9",
    "#2C6E8F",
    "#E0A458",
    "#8A6FB0",
    "#C15B5B",
    "#6B7A82",
    "#9BD3C4",
    "#3D5A66"
  ],
  "foreground": "#1F2A37",
  "foregroundNeutralSecondary": "#4B5A63",
  "foregroundNeutralTertiary": "#8A979E",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F6F7",
  "backgroundNeutral": "#E5E9EC",
  "tableAccent": "#0E7C66",
  "good": "#1E9E77",
  "neutral": "#E0A458",
  "bad": "#C15B5B",
  "maximum": "#0E7C66",
  "center": "#9BD3C4",
  "minimum": "#E5E9EC",
  "null": "#F4F6F7",
  "hyperlink": "#0E7C66",
  "visitedHyperlink": "#0A5C4C",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1F2A37" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2A37" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 34, "color": "#0E7C66" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4B5A63" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [ { "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 } ],
        "border": [ { "show": true, "color": { "solid": { "color": "#E5E9EC" } }, "radius": 8 } ],
        "dropShadow": [ { "show": true, "preset": "Custom", "color": { "solid": { "color": "#1F2A37" } }, "position": "Outer", "angle": 90, "shadowSpread": 1, "shadowBlur": 10, "transparency": 88 } ],
        "visualHeader": [ { "show": true, "background": { "solid": { "color": "#FFFFFF" } }, "border": { "solid": { "color": "#FFFFFF" } }, "foreground": { "solid": { "color": "#8A979E" } } } ],
        "title": [ { "show": true, "titleWrap": true, "fontColor": { "solid": { "color": "#1F2A37" } }, "fontSize": 13, "fontFamily": "Segoe UI Semibold", "alignment": "left", "background": { "solid": { "color": "#FFFFFF" } } } ],
        "spacing": [ { "customizeSpacing": true, "spaceBelowTitle": 6 } ]
      }
    },
    "page": {
      "*": {
        "background": [ { "color": { "solid": { "color": "#F4F6F7" } }, "transparency": 0 } ],
        "outspace": [ { "color": { "solid": { "color": "#F4F6F7" } }, "transparency": 0 } ]
      }
    },
    "card": {
      "*": {
        "background": [ { "show": true, "color": { "solid": { "color": "#FFFFFF" } } } ],
        "border": [ { "show": true, "color": { "solid": { "color": "#E5E9EC" } }, "radius": 10 } ],
        "labels": [ { "color": { "solid": { "color": "#0E7C66" } }, "fontSize": 30, "fontFamily": "Segoe UI Semibold" } ],
        "categoryLabels": [ { "show": true, "color": { "solid": { "color": "#6B7A82" } }, "fontSize": 11, "fontFamily": "Segoe UI" } ]
      }
    },
    "cardVisual": {
      "*": {
        "calloutValue": [ { "fontFamily": "Segoe UI Semibold", "fontSize": 30, "color": { "solid": { "color": "#0E7C66" } } } ]
      }
    },
    "kpi": {
      "*": {
        "trendline": [ { "show": true } ],
        "indicator": [ { "color": { "solid": { "color": "#0E7C66" } }, "fontSize": 28 } ],
        "goals": [ { "color": { "solid": { "color": "#6B7A82" } } } ]
      }
    },
    "slicer": {
      "*": {
        "background": [ { "show": true, "color": { "solid": { "color": "#FFFFFF" } } } ],
        "border": [ { "show": true, "color": { "solid": { "color": "#E5E9EC" } }, "radius": 8 } ],
        "header": [ { "show": true, "fontColor": { "solid": { "color": "#1F2A37" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 11 } ],
        "items": [ { "fontColor": { "solid": { "color": "#4B5A63" } }, "fontFamily": "Segoe UI", "fontSize": 10 } ]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [ { "fill": { "solid": { "color": "#0E7C66" } } } ],
        "valueAxis": [ { "show": true, "gridlineShow": true, "gridlineColor": { "solid": { "color": "#EDF1F2" } }, "gridlineThickness": 1 } ],
        "categoryAxis": [ { "show": true, "labelColor": { "solid": { "color": "#6B7A82" } } } ],
        "labels": [ { "show": true, "color": { "solid": { "color": "#1F2A37" } }, "fontSize": 9 } ]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [ { "fill": { "solid": { "color": "#14A085" } } } ],
        "valueAxis": [ { "show": true, "gridlineColor": { "solid": { "color": "#EDF1F2" } } } ],
        "categoryAxis": [ { "labelColor": { "solid": { "color": "#6B7A82" } } } ],
        "labels": [ { "show": true, "color": { "solid": { "color": "#1F2A37" } }, "fontSize": 9 } ]
      }
    },
    "lineChart": {
      "*": {
        "dataPoint": [ { "fill": { "solid": { "color": "#0E7C66" } } } ],
        "lineStyles": [ { "strokeWidth": 3, "showMarker": true } ],
        "valueAxis": [ { "gridlineColor": { "solid": { "color": "#EDF1F2" } } } ],
        "categoryAxis": [ { "labelColor": { "solid": { "color": "#6B7A82" } } } ]
      }
    },
    "areaChart": {
      "*": {
        "dataPoint": [ { "fill": { "solid": { "color": "#14A085" } } }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [ { "show": true, "position": "Right", "labelColor": { "solid": { "color": "#4B5A63" } } } ],
        "labels": [ { "color": { "solid": { "color": "#1F2A37" } }, "fontSize": 9 } ]
      }
    },
    "pieChart": {
      "*": {
        "legend": [ { "show": true, "position": "Right", "labelColor": { "solid": { "color": "#4B5A63" } } } ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [ { "gridVertical": true, "gridVerticalColor": { "solid": { "color": "#EDF1F2" } }, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#EDF1F2" } }, "rowPadding": 6 } ],
        "columnHeaders": [ { "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#0E7C66" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 10 } ],
        "values": [ { "fontColor": { "solid": { "color": "#1F2A37" } }, "fontSize": 10, "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#F7FAFA" } } } ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [ { "gridVerticalColor": { "solid": { "color": "#EDF1F2" } }, "gridHorizontalColor": { "solid": { "color": "#EDF1F2" } }, "rowPadding": 6 } ],
        "columnHeaders": [ { "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#0E7C66" } }, "fontFamily": "Segoe UI Semibold" } ],
        "values": [ { "fontColor": { "solid": { "color": "#1F2A37" } }, "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#F7FAFA" } } } ]
      }
    }
  }
}
